{
  "expo": {
    "name": "Magellan",
    "slug": "magellan-native",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "magellan",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.khaledahmed.magellan",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Magellan needs your location for GNSS navigation, waypoints, and sharing your position."
      }
    },
    "android": {
      "package": "com.khaledahmed.magellan",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Magellan needs your location for GNSS navigation, waypoints, and sharing your position."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Magellan needs camera access to scan location QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ea5a912-2916-4e74-b0dd-5123a09a5dfc"
      }
    },
    "owner": "khalidahmed87"
  }
}
